# Application settings. These values are not secrets.
OPS_AGENT_ENV=production
OPS_AGENT_LOG_LEVEL=INFO

# Compose-only settings. Defaults shown here match docker-compose.yml.
OPS_AGENT_IMAGE=ops-agent-core:0.1.0
OPS_AGENT_PORT=8000
OPS_AGENT_PRODUCT_SKILLS_HOST_PATH=./runtime-data/product-skills

# Offline-delivery images. Both are included by scripts/package_release.sh.
OPS_AGENT_BASE_IMAGE=ops-agent-runtime-base:py311-playwright1.63
OPS_AGENT_TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0

# Skill installation paths are not secrets.
# Direct local-process default when omitted: skills/builtin.
# Compose supplies /opt/ops-agent/skills/builtin inside the container.
OPS_AGENT_BUILTIN_SKILLS_PATH=skills/builtin

# Required when assembling RealKnowledgeEngine.
# For a direct local process, use the external repository mount point below.
# Compose supplies /opt/ops-agent/plugins/product-skills inside the container.
# Override explicitly with tests/fixtures/product-skills only for TestProduct tests.
OPS_AGENT_PRODUCT_SKILLS_PATH=runtime-data/product-skills

# Optional; must match skill.toml core_api. Current default: 1.0
OPS_AGENT_SKILL_CORE_API=1.0

# Comma-separated Host headers accepted by Runtime MCP DNS-rebinding protection.
# Add the exact internal hostname/IP and port used in the CodeBuddy endpoint.
OPS_AGENT_MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000

# Reproduction deployment. Compose defaults enable real Chromium + Toxiproxy.
# Set OPS_AGENT_REPRODUCTION_ADAPTER=fake to disable external browser/fault execution.
OPS_AGENT_REPRODUCTION_ADAPTER=playwright-toxiproxy
OPS_AGENT_BROWSER_HEADLESS=true

# REQUIRED: upstream test/demo service reachable from the Toxiproxy container.
# Never point this at production. Linux host access is mapped by Compose.
OPS_AGENT_TOXIPROXY_UPSTREAM=host.docker.internal:8080

# Non-sensitive fault profile defaults.
OPS_AGENT_TOXIPROXY_LATENCY_MS=80
OPS_AGENT_REPRODUCTION_TOOL_TIMEOUT_SECONDS=10
