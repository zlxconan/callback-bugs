OPS_AGENT_ENV=development
OPS_AGENT_LOG_LEVEL=INFO

# Skill installation paths are not secrets.
# Development default when omitted: skills/builtin
# Container deployments should set: /opt/ops-agent/skills/builtin
OPS_AGENT_BUILTIN_SKILLS_PATH=skills/builtin

# Required when assembling RealKnowledgeEngine.
# This example intentionally points only to synthetic test plugins.
# Container deployments should mount the external repository read-only at
# /opt/ops-agent/plugins/product-skills and set this value to that path.
OPS_AGENT_PRODUCT_SKILLS_PATH=tests/fixtures/product-skills

# Optional; must match skill.toml core_api. Current default: 1.0
OPS_AGENT_SKILL_CORE_API=1.0
