FROM python:3.11-slim

LABEL org.opencontainers.image.title="Ops Agent Runtime Base" \
      org.opencontainers.image.description="Python dependencies and Playwright Chromium for offline Ops Agent builds"

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /tmp/ops-agent-base

COPY pyproject.toml ./

RUN python -c "import pathlib,tomllib; data=tomllib.loads(pathlib.Path('pyproject.toml').read_text()); pathlib.Path('requirements-runtime.txt').write_text('\\n'.join(data['project']['dependencies']) + '\\n')" \
    && python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --requirement requirements-runtime.txt \
    && python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/* /root/.cache /tmp/ops-agent-base

WORKDIR /opt/ops-agent
